server {
    listen 80;
    server_name localhost;

    # Default is 1m, which rejects any real video upload (live-session
    # recordings) with a 413 before the request even reaches the backend.
    client_max_body_size 200m;

    # BACKEND_ORIGIN is a real *runtime* env var (e.g. -e BACKEND_ORIGIN=http://13.60.83.25:8000),
    # substituted into this template by the nginx image's docker-entrypoint at
    # container startup (see envsubst.sh / NGINX_ENVSUBST_FILTER in Dockerfile.prod).
    # Changing the backend address only requires restarting the container, not rebuilding the image.

    location /auth/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
    }

    location /api/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Plan generation (workout/nutrition) streams SSE over this prefix and
        # can run well past nginx's default 60s read timeout; buffering must
        # also be off or nginx holds the whole response before flushing it,
        # which defeats streaming and can itself look like a stall/timeout.
        proxy_connect_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    location /ws/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
