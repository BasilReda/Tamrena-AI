# ─── Google GenAI / Gemini Central Configuration ──────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
MODEL_NAME=gemini-3.5-flash-lite

# ─── ITI Bedrock ──────────────────────────────────────────────────────────────
SBG_API_KEY=your_bedrock_api_key
SBG_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0

# ─── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY2=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
COMPOSITION_MEAL_MODEL=openai/gpt-oss-120b

# ─── LangSmith ─────────────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=NutritionAgent

# ─── Food Dataset ──────────────────────────────────────────────────────────────
FOOD_DATA_PATH=DataPrep/usedData/egyption_agents_food_db.csv

# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── Agent Settings ────────────────────────────────────────────────────────────
MAX_RETRIES=3

# ─── Internal service auth ──────────────────────────────────────────────────────
INTERNAL_SERVICE_TOKEN=your_internal_service_token_here
